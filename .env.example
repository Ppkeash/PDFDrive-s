# Supabase - copiar a .env.local y rellenar
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo backend / edge functions (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Pon "true" SOLO después de cargar las credenciales de Google en
# Supabase (Auth > Providers > Google). Si no, el botón se oculta en vez
# de mostrarse y fallar.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
