# Supabase - copiar a .env.local y rellenar
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo backend / edge functions (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Pon "true" SOLO después de cargar las credenciales de Google en
# Supabase (Auth > Providers > Google). Si no, el botón se oculta en vez
# de mostrarse y fallar.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# ---------------------------------------------------------------------------
# Puerta de acceso (Fase A): la app no debe ser encontrable desde fuera.
# Con ACCESS_GATE_ENABLED distinto de "true" la puerta queda abierta; útil en
# local. La cabecera X-Robots-Tag y robots.txt actúan siempre.
# ---------------------------------------------------------------------------
ACCESS_GATE_ENABLED=false

# IPs públicas que entran sin frase. Coma como separador. Acepta IP exacta
# (v4/v6) y rango CIDR v4: 190.12.34.56,201.44.0.0/16
ACCESS_ALLOWED_IPS=

# Para quien trabaja fuera de la oficina: abrir cualquier URL una vez con
# ?acceso=<frase> deja la cookie puesta. Usar algo largo, no una palabra.
ACCESS_PASSPHRASE=

# Firma de la cookie de acceso. Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_COOKIE_SECRET=

# Días que dura la cookie antes de pedir la frase otra vez.
ACCESS_COOKIE_DAYS=30

# ---------------------------------------------------------------------------
# Correo (Fase C). Estas NO van aqui: se cargan en los secretos de las edge
# functions con `supabase secrets set --project-ref <ref> CLAVE=valor`.
# Se listan para saber que hace falta, nunca con su valor.
# ---------------------------------------------------------------------------
#   SEND_EMAILS_SECRET   secreto compartido entre la tarea programada y la
#                        funcion. El mismo valor va en Vault, como
#                        'send_emails_secret'.
#   EMAIL_PROVIDER       smtp | resend
#   EMAIL_FROM           "FirmaDrive <avisos@ejemplo.com>"
#   SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASS
#   RESEND_API_KEY       solo si EMAIL_PROVIDER=resend
#   EMAIL_BATCH_SIZE     correos por corrida (por defecto 25)
